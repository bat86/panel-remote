<?xml version="1.0" encoding="utf-8"?>
<!-- Источник пакетов нужен для restore runtime-паков при single-file publish.
     Без него dotnet publish -r win-x64 падает с NU1100, если в пользовательском
     NuGet.Config список источников пуст. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
